{
  "manifest_version": 3,
  "name": "JOTO AI Front Test Companion",
  "version": "1.2.0",
  "description": "Runs user-initiated, single AI frontend captures through a local Runner.",
  "permissions": ["activeTab", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:17321/*",
    "https://www.doubao.com/*",
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://tongyi.aliyun.com/qianwen/*",
    "https://chat.qwen.ai/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "JOTO AI Front Test Companion"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://tongyi.aliyun.com/qianwen/*",
        "https://chat.qwen.ai/*"
      ],
      "js": ["src/adapters/china-ai.js", "src/content/capture.js"],
      "run_at": "document_idle"
    }
  ]
}
