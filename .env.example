# Copy this file to .env. Values below are local placeholders, not real credentials.
# Replace both passwords before exposing any port beyond localhost.
DEPLOYMENT_PROFILE=full
WORKBENCH_PORT=3027
WORKBENCH_IMAGE_TAG=0.1.0

MYSQL_DATABASE=joto_workbench
MYSQL_USER=joto
MYSQL_PASSWORD=replace-with-a-long-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_EXPOSE_PORT=3306

OPENSEARCH_EXPOSE_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# Required for the full RAG/content pipeline. Never commit the populated .env.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
V5_SAMPLE_ARTICLE_PROVIDER=qwen
QWEN_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_PROVIDER=qwen_embedding

# Optional: three AI-generated cover candidates for the current WeChat article.
WECHAT_VISUAL_IMAGE_BASE_URL=
WECHAT_VISUAL_IMAGE_API_KEY=
WECHAT_VISUAL_IMAGE_MODEL=
WECHAT_VISUAL_IMAGE_ENDPOINT=images/generations
WECHAT_VISUAL_IMAGE_SIZE=1792x768
WECHAT_VISUAL_IMAGE_TIMEOUT_MS=180000
WECHAT_VISUAL_IMAGE_PROVIDER_LABEL=
V5_FREE_PRODUCTION_ASSET_PATH=data/free-production-assets
V5_WECHAT_VISUAL_STATE_PATH=data/v5-wechat-visual-plans.json
V5_WECHAT_VISUAL_STORAGE_PATH=data/v5-wechat-visual-candidates

# GEO research fans factual search out to Zhipu, Doubao, and Qwen.
# Zhipu GLM is the sole semantic synthesis/orchestration model.
GEO_RESEARCH_ZHIPU_API_KEY=
GEO_RESEARCH_ZHIPU_MODEL=glm-4-air
GEO_RESEARCH_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GEO_RESEARCH_ZHIPU_SEARCH_ENGINE=search_pro
GEO_RESEARCH_ZHIPU_SEARCH_COUNT=10
GEO_RESEARCH_ZHIPU_SEARCH_RECENCY=noLimit
GEO_RESEARCH_ZHIPU_CONTENT_SIZE=high
GEO_RESEARCH_ZHIPU_MAX_QUERIES=3
GEO_RESEARCH_DOUBAO_API_KEY=
GEO_RESEARCH_DOUBAO_MODEL=
GEO_RESEARCH_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GEO_RESEARCH_QWEN_API_KEY=
GEO_RESEARCH_QWEN_MODEL=
GEO_RESEARCH_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# GEO hosted-mode email and signed action links. The values below are public
# placeholders only. Populate the ignored .env on the deployment machine.
# 127.0.0.1 is suitable only for local acceptance, not user-facing emails.
HOSTED_PUBLIC_BASE_URL=http://127.0.0.1:3027
HOSTED_REVIEW_LINK_SECRET=
HOSTED_EMAIL_DELIVERY_URL=
HOSTED_EMAIL_DELIVERY_TOKEN=
HOSTED_DAILY_DIGEST_CUTOFF_HOUR=20

# Safe publish defaults. The Windows browser bridge remains outside Docker.
DIRECT_PUBLISH_ENABLED=false
DIRECT_PUBLISH_MOCK=true
WECHATSYNC_ENABLED=false
WECHATSYNC_MOCK=true
WECHATSYNC_BRIDGE_URL=http://host.docker.internal:9528

# Content metrics stays inside the Docker private network. Only the shared
# bearer token is supplied from the local secret environment.
CONTENT_METRICS_RUNNER_TOKEN=
CONTENT_METRICS_INTERVAL_SECONDS=21600

# GEO website audit and governed question monitoring.
SITE_AUDIT_MAX_PAGES=25
SITE_AUDIT_WORKER_INTERVAL_SECONDS=30
SITE_AUDIT_RENDERER_URL=
SITE_AUDIT_RENDERER_TOKEN=
GEO_MONITORING_SCHEDULER_INTERVAL_SECONDS=3600

# Worker polling intervals in seconds.
RAG_INDEX_WORKER_INTERVAL_SECONDS=15
RAG_SOURCE_IMPORT_INTERVAL_SECONDS=300
KNOWLEDGE_REFRESH_INTERVAL_SECONDS=15
KNOWLEDGE_COLLECTION_INTERVAL_SECONDS=900
CONTENT_WORKER_INTERVAL_SECONDS=15
AI_PROVIDER_PREFLIGHT_TIMEOUT_MS=8000
AI_PROVIDER_FORMAL_TIMEOUT_MS=180000
AI_PROVIDER_FORMAL_DEADLINE_MS=360000
AI_PROVIDER_FORMAL_MAX_CALLS=3
AI_PROVIDER_FORMAL_MAX_ATTEMPTS_PER_ROUND=2
V5_SAMPLE_WORKER_BATCH_SIZE=3
V5_CONTENT_WORKER_BATCH_SIZE=20
V5_SAMPLE_WORKER_CONCURRENCY=2
V5_CONTENT_WORKER_CONCURRENCY=2
V5_SAMPLE_OPERATION_STALE_MINUTES=20
V5_SAMPLE_OPERATION_MAX_ATTEMPTS=3
PUBLISH_WORKER_INTERVAL_SECONDS=30
WORKER_HEALTH_MAX_AGE_SECONDS=45

LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
