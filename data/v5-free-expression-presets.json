{
  "sourceRuleDocumentId": "joto-wechat-content-guidelines",
  "sourceRuleVersion": "2026.1",
  "brandBaseline": {
    "problemBeforeProduct": true,
    "translateFeatureToWorkflowValue": true,
    "humanKeepsFinalDecision": true,
    "forbidUnverifiedClaims": true,
    "sentenceLengthRange": [15, 35],
    "maximumExplanationSentenceLength": 55,
    "paragraphSentenceRange": [1, 3],
    "requireMediaContextAndCaption": true,
    "requireRestrainedCta": true
  },
  "presets": [
    {
      "presetKey": "product_release",
      "name": "产品自研 / 产品发布",
      "description": "进入真实场景，解释产品为何存在、接手哪段工作流以及带来的变化。",
      "scenario": "产品能力介绍与正式发布",
      "contentGoal": "解释产品为何存在、进入哪段业务流程并带来什么变化",
      "defaultAudience": "企业业务与技术负责人",
      "productId": "product-kb-adp-service",
      "knowledgeSnapshotIds": ["kb-adp-service:v1"],
      "channelBinding": { "channel": "wechat_official_account", "channelRuleVersionId": "wechat-article-v1", "ctaType": "contact_joto", "requiredPublishAssetKeys": ["wechat_cover"] },
      "visualSuggestionMode": "placeholders",
      "structureModules": ["real_scene", "pain_cost", "key_judgment", "product_positioning", "workflow_sections", "human_ai_boundary", "value_close", "cta"],
      "optionalStructureModules": ["faq", "implementation_boundary"],
      "requiredInputSchema": [
        { "key": "launch_status", "label": "上线状态", "reason": "正文不能推断产品是否已经正式上线。", "defaultStatus": "needs_approval", "inputSchema": { "type": "select", "label": "确认上线状态", "required": true, "options": [{ "value": "launched", "label": "已正式上线" }, { "value": "pilot", "label": "试点或内测" }, { "value": "not_public", "label": "暂不公开说明" }] }, "affectedSectionKeys": ["product_positioning", "value_close"] },
        { "key": "cta_url", "label": "有效 CTA", "reason": "自动发布前需要可用且已批准的行动链接。", "defaultStatus": "needs_input", "inputSchema": { "type": "url", "label": "CTA 链接", "placeholder": "https://", "required": true, "maxLength": 500 }, "affectedSectionKeys": ["cta"] },
        { "key": "wechat_cover", "label": "公众号封面", "reason": "公众号发布必须绑定封面素材。", "defaultStatus": "blocked", "inputSchema": { "type": "file", "label": "选择封面图片", "required": true, "acceptedMimeTypes": ["image/jpeg", "image/png", "image/webp"] }, "affectedSectionKeys": [] }
      ],
      "recommendedLength": { "min": 1800, "max": 2800 },
      "allowedTitleStrategyKeys": ["pain_suspense", "role_resonance", "value_release", "industry_question"],
      "defaultTitleStrategyKey": "value_release",
      "audienceLensPolicy": "business_owner",
      "promotionStrength": "moderate",
      "firstProductMentionRule": "after_real_scene_and_pain",
      "defaultExpressionFocus": ["说明工作流变化", "强调人的最终判断权"],
      "additionalWritingRequirements": "正式官宣时产品可出现在标题，其他情况先建立场景和痛点。"
    },
    {
      "presetKey": "scenario_solution",
      "name": "场景案例 / 解决方案",
      "description": "聚焦具体任务与前后变化，用可核验结果说明 AI 如何接手重复动作。",
      "scenario": "具体业务任务的解决方案与案例",
      "contentGoal": "用一个具体任务证明 AI 如何接手重复动作并产生可验证结果",
      "defaultAudience": "业务部门负责人和一线使用者",
      "productId": "product-kb-adp-service",
      "knowledgeSnapshotIds": ["kb-adp-service:v1"],
      "channelBinding": { "channel": "wechat_official_account", "channelRuleVersionId": "wechat-article-v1", "ctaType": "contact_joto", "requiredPublishAssetKeys": ["wechat_cover"] },
      "visualSuggestionMode": "placeholders",
      "structureModules": ["deadline_scene", "task_complexity", "old_workflow", "assistant_action", "human_ai_boundary", "result_evidence", "cta"],
      "optionalStructureModules": ["implementation_path", "faq"],
      "requiredInputSchema": [
        { "key": "result_evidence", "label": "结果证据", "reason": "案例结果需要可追溯依据，不能由模型推断。", "defaultStatus": "needs_input", "inputSchema": { "type": "textarea", "label": "补充前后变化或结果依据", "required": true, "maxLength": 1000 }, "affectedSectionKeys": ["result_evidence"] },
        { "key": "cta_url", "label": "有效 CTA", "reason": "自动发布前需要可用且已批准的行动链接。", "defaultStatus": "needs_input", "inputSchema": { "type": "url", "label": "CTA 链接", "placeholder": "https://", "required": true, "maxLength": 500 }, "affectedSectionKeys": ["cta"] },
        { "key": "wechat_cover", "label": "公众号封面", "reason": "公众号发布必须绑定封面素材。", "defaultStatus": "blocked", "inputSchema": { "type": "file", "label": "选择封面图片", "required": true, "acceptedMimeTypes": ["image/jpeg", "image/png", "image/webp"] }, "affectedSectionKeys": [] }
      ],
      "recommendedLength": { "min": 1200, "max": 2000 },
      "allowedTitleStrategyKeys": ["pain_suspense", "role_resonance"],
      "defaultTitleStrategyKey": "pain_suspense",
      "audienceLensPolicy": "frontline_user",
      "promotionStrength": "moderate",
      "firstProductMentionRule": "after_old_workflow",
      "defaultExpressionFocus": ["从高压现场开始", "展示人工动作前后变化"],
      "additionalWritingRequirements": "不得在开头先写产品概述，结果必须标明证据边界。"
    },
    {
      "presetKey": "strategic_partnership",
      "name": "战略合作 / 客户里程碑",
      "description": "事实优先、正式克制，说明合作双方、范围、能力与长期价值。",
      "scenario": "战略合作与客户里程碑官宣",
      "contentGoal": "可信地说明合作事实、双方能力、服务内容和长期价值",
      "defaultAudience": "企业管理者、采购决策者与生态伙伴",
      "productId": "product-kb-adp-service",
      "knowledgeSnapshotIds": ["kb-adp-service:v1"],
      "channelBinding": { "channel": "wechat_official_account", "channelRuleVersionId": "wechat-article-v1", "ctaType": "brand_follow", "requiredPublishAssetKeys": ["wechat_cover"] },
      "visualSuggestionMode": "placeholders",
      "structureModules": ["announcement", "cooperation_background", "cooperation_scope", "complementary_capabilities", "cooperation_value", "next_steps", "brand_close"],
      "optionalStructureModules": ["quote", "milestone_timeline"],
      "requiredInputSchema": [
        { "key": "partner_authorization", "label": "合作方名称授权", "reason": "合作方名称与合作事实必须有公开授权。", "defaultStatus": "needs_approval", "inputSchema": { "type": "textarea", "label": "授权说明或匿名表达要求", "required": true, "maxLength": 1000 }, "affectedSectionKeys": ["announcement", "cooperation_background", "cooperation_scope"] },
        { "key": "next_steps", "label": "下一阶段计划", "reason": "后续规划不能由模型推断。", "defaultStatus": "needs_input", "inputSchema": { "type": "textarea", "label": "可公开的下一阶段计划", "required": true, "maxLength": 800 }, "affectedSectionKeys": ["next_steps"] },
        { "key": "wechat_cover", "label": "公众号封面", "reason": "公众号发布必须绑定封面素材。", "defaultStatus": "blocked", "inputSchema": { "type": "file", "label": "选择封面图片", "required": true, "acceptedMimeTypes": ["image/jpeg", "image/png", "image/webp"] }, "affectedSectionKeys": [] }
      ],
      "recommendedLength": { "min": 800, "max": 1400 },
      "allowedTitleStrategyKeys": ["value_release"],
      "defaultTitleStrategyKey": "value_release",
      "audienceLensPolicy": "ecosystem_partner",
      "promotionStrength": "restrained",
      "firstProductMentionRule": "announcement_first_paragraph",
      "defaultExpressionFocus": ["合作事实优先", "双方能力边界清晰"],
      "additionalWritingRequirements": "首段可直接出现合作双方和动作，但所有名称、范围和计划必须有授权依据。"
    },
    {
      "presetKey": "event_recap",
      "name": "会议活动 / 品牌事件",
      "description": "提炼活动观点与案例，将现场信息沉淀为可复用的行业判断。",
      "scenario": "会议活动、品牌事件与观点复盘",
      "contentGoal": "沉淀活动观点、案例证据和 JOTO 的行业立场",
      "defaultAudience": "活动参与者、行业从业者与企业管理者",
      "productId": "product-kb-adp-service",
      "knowledgeSnapshotIds": ["kb-adp-service:v1"],
      "channelBinding": { "channel": "wechat_official_account", "channelRuleVersionId": "wechat-article-v1", "ctaType": "brand_follow", "requiredPublishAssetKeys": ["wechat_cover"] },
      "visualSuggestionMode": "placeholders",
      "structureModules": ["event_facts", "event_thesis", "speaker_insights", "case_evidence", "product_context", "brand_close"],
      "optionalStructureModules": ["agenda", "audience_questions"],
      "requiredInputSchema": [
        { "key": "event_facts", "label": "活动事实", "reason": "时间、地点、主办方和参与对象必须准确。", "defaultStatus": "needs_input", "inputSchema": { "type": "textarea", "label": "活动时间、地点、主办方和参与对象", "required": true, "maxLength": 1000 }, "affectedSectionKeys": ["event_facts"] },
        { "key": "quote_authorization", "label": "嘉宾原话授权", "reason": "嘉宾姓名与原话需要授权或匿名处理。", "defaultStatus": "needs_approval", "inputSchema": { "type": "textarea", "label": "授权说明或匿名表达要求", "required": true, "maxLength": 1000 }, "affectedSectionKeys": ["speaker_insights"] },
        { "key": "wechat_cover", "label": "公众号封面", "reason": "公众号发布必须绑定封面素材。", "defaultStatus": "blocked", "inputSchema": { "type": "file", "label": "选择封面图片", "required": true, "acceptedMimeTypes": ["image/jpeg", "image/png", "image/webp"] }, "affectedSectionKeys": [] }
      ],
      "recommendedLength": { "min": 1200, "max": 2200 },
      "allowedTitleStrategyKeys": ["value_release", "industry_question"],
      "defaultTitleStrategyKey": "industry_question",
      "audienceLensPolicy": "executive",
      "promotionStrength": "restrained",
      "firstProductMentionRule": "inside_event_topic",
      "defaultExpressionFocus": ["活动观点可复用", "案例和原话可追溯"],
      "additionalWritingRequirements": "产品作为活动议题的一部分自然出现，不把活动复盘写成产品广告。"
    },
    {
      "presetKey": "industry_insight",
      "name": "行业洞察 / 软性产品种草",
      "description": "先建立行业判断，再自然引出产品对真实工作流的回应。",
      "scenario": "行业趋势、业务判断与软性产品表达",
      "contentGoal": "先建立行业判断，再自然引出产品回应",
      "defaultAudience": "企业管理者与数字化负责人",
      "productId": "product-kb-adp-service",
      "knowledgeSnapshotIds": ["kb-adp-service:v1"],
      "channelBinding": { "channel": "wechat_official_account", "channelRuleVersionId": "wechat-article-v1", "ctaType": "soft_contact", "requiredPublishAssetKeys": ["wechat_cover"] },
      "visualSuggestionMode": "placeholders",
      "structureModules": ["contrarian_thesis", "scene_details", "root_cause", "industry_judgment", "product_response", "workflow_change", "soft_cta"],
      "optionalStructureModules": ["counterargument", "decision_checklist"],
      "requiredInputSchema": [
        { "key": "industry_basis", "label": "行业判断依据", "reason": "行业趋势与数据结论需要来源，不能由模型泛化。", "defaultStatus": "needs_input", "inputSchema": { "type": "textarea", "label": "补充行业现象或判断依据", "required": true, "maxLength": 1200 }, "affectedSectionKeys": ["contrarian_thesis", "industry_judgment"] },
        { "key": "cta_url", "label": "有效 CTA", "reason": "自动发布前需要可用且已批准的行动链接。", "defaultStatus": "needs_input", "inputSchema": { "type": "url", "label": "CTA 链接", "placeholder": "https://", "required": true, "maxLength": 500 }, "affectedSectionKeys": ["soft_cta"] },
        { "key": "wechat_cover", "label": "公众号封面", "reason": "公众号发布必须绑定封面素材。", "defaultStatus": "blocked", "inputSchema": { "type": "file", "label": "选择封面图片", "required": true, "acceptedMimeTypes": ["image/jpeg", "image/png", "image/webp"] }, "affectedSectionKeys": [] }
      ],
      "recommendedLength": { "min": 1500, "max": 2400 },
      "allowedTitleStrategyKeys": ["pain_suspense", "role_resonance", "industry_question"],
      "defaultTitleStrategyKey": "industry_question",
      "audienceLensPolicy": "it_digital",
      "promotionStrength": "restrained",
      "firstProductMentionRule": "after_twenty_percent",
      "defaultExpressionFocus": ["行业判断先于产品", "产品回应真实工作流"],
      "additionalWritingRequirements": "产品首次出现不得早于正文前 20%，不得用无依据趋势结论制造焦虑。"
    }
  ]
}
