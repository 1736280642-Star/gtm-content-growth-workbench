{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-dev-3027/types/**/*.ts",
    ".next-dev-3030/types/**/*.ts",
    ".next-dev-3047/types/**/*.ts",
    ".next-dev-3048/types/**/*.ts",
    ".next-dev-3050/types/**/*.ts",
    ".next-live-acceptance-3069/types/**/*.ts",
    ".next-smoke-browser-3068/types/**/*.ts",
    ".next-smoke-browser-3069/types/**/*.ts",
    ".next-smoke-workflow-3057/types/**/*.ts",
    ".next-smoke-workflow-3061/types/**/*.ts",
    ".next-smoke-workflow-3062/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-smoke-browser-3058/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "content-publish-engine"
  ]
}
