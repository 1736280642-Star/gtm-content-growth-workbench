{
  "manifest_version": 3,
  "name": "JOTO Publish Executor",
  "version": "1.0.0",
  "key": "",
  "description": "Executes deterministic JOTO publish jobs in authenticated platform page contexts.",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:9528/*",
    "http://localhost:9528/*",
    "https://juejin.cn/*",
    "https://api.juejin.cn/*",
    "https://editor.csdn.net/*",
    "https://mp.csdn.net/*",
    "https://blog.csdn.net/*",
    "https://zhuanlan.zhihu.com/*",
    "https://www.zhihu.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
