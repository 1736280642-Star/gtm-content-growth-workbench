# JOTO GTM Workbench V5 environment template
# Copy required entries into .env.local. Never commit real credentials.

# -----------------------------------------------------------------------------
# 1. Workbench runtime and local state
# -----------------------------------------------------------------------------
WORKBENCH_BASE_URL=http://127.0.0.1:3050
V5_WORKBENCH_BASE_URL=http://127.0.0.1:3050
WORKBENCH_STORAGE=local_json
WORKBENCH_STATE_PATH=data/workbench-state.json
V5_FOUNDATION_STATE_PATH=data/v5-foundation-state.json
V5_MONTHLY_STATE_PATH=data/v5-monthly-workbench.json
V5_ARTICLE_TYPE_STATE_PATH=data/v5-article-types.json
V5_OBSERVATION_STATE_PATH=data/v5-observation-review.json
V5_CAPTURE_ARTIFACT_ROOT=artifacts/v5-frontend-capture
V5_OBSERVATION_REFERENCE_PATH=
WORKBENCH_CANONICAL_ROOT=D:/GTM/工作台
CHROME_PATH=

# -----------------------------------------------------------------------------
# 2. MySQL persistence (required for formal V5 governance and production)
# -----------------------------------------------------------------------------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_BRIDGE_TIMEOUT_MS=15000
MYSQL_BRIDGE_MAX_BUFFER_BYTES=16777216

# Change to mysql only after every MYSQL_* value is configured.
# WORKBENCH_STORAGE=mysql

# -----------------------------------------------------------------------------
# 3. OpenSearch (required for formal RAG)
# -----------------------------------------------------------------------------
OPENSEARCH_URL=
OPENSEARCH_AUTH_MODE=auto
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# 4. AI providers
# -----------------------------------------------------------------------------
V5_FORMAL_ARTICLE_PROVIDER=qwen
V5_SAMPLE_ARTICLE_PROVIDER=qwen
ARTICLE_TYPE_AI_PROVIDER=qwen
CONTENT_GENERATION_PROVIDER=qwen
AI_PROVIDER_TIMEOUT_MS=120000
AI_PROVIDER_PREFLIGHT_TIMEOUT_MS=8000
AI_PROVIDER_FORMAL_TIMEOUT_MS=180000
AI_PROVIDER_FORMAL_DEADLINE_MS=360000
AI_PROVIDER_FORMAL_MAX_CALLS=3
AI_PROVIDER_FORMAL_MAX_ATTEMPTS_PER_ROUND=2
EMBEDDING_PROVIDER_TIMEOUT_MS=60000

# WeChat visual cover generation (OpenAI-compatible Images API)
WECHAT_VISUAL_IMAGE_BASE_URL=
WECHAT_VISUAL_IMAGE_API_KEY=
WECHAT_VISUAL_IMAGE_MODEL=
WECHAT_VISUAL_IMAGE_ENDPOINT=images/generations
WECHAT_VISUAL_IMAGE_SIZE=1792x768
WECHAT_VISUAL_IMAGE_TIMEOUT_MS=180000
V5_FREE_PRODUCTION_ASSET_PATH=data/free-production-assets
V5_WECHAT_VISUAL_STATE_PATH=data/v5-wechat-visual-plans.json
V5_WECHAT_VISUAL_STORAGE_PATH=data/v5-wechat-visual-candidates
WECHAT_VISUAL_IMAGE_PROVIDER_LABEL=

# Qwen / Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Doubao / Volcengine Ark
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_EMBEDDING_MODEL=
DOUBAO_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# -----------------------------------------------------------------------------
# 5. Formal RAG
# -----------------------------------------------------------------------------
RAG_EMBEDDING_PROVIDER=qwen_embedding
RAG_EMBEDDING_BATCH_SIZE=10
RAG_OPENSEARCH_BULK_SIZE=100
RAG_JOB_LEASE_SECONDS=300

# Workbench document and URL imports are stored in MySQL. They do not require
# RAG_IMPORT_* or RAG_SOURCE_ROOT_* local-path configuration.

# -----------------------------------------------------------------------------
# 6. Knowledge URL crawling and blog sources
# -----------------------------------------------------------------------------
XCRAWL_API_KEY=
XCRAWL_BASE_URL=https://run.xcrawl.com/v1
XCRAWL_TIMEOUT_MS=45000

# Optional proxy fallback. Leave blank when XCrawl is sufficient.
KNOWLEDGE_PROXY_FETCH_BASE_URL=
KNOWLEDGE_PROXY_FETCH_API_KEY=
KNOWLEDGE_PROXY_FETCH_TIMEOUT_MS=45000

# Allowed values: xcrawl, proxy_fetch, local_fetch
KNOWLEDGE_CRAWL_PRIMARY_PROVIDER=xcrawl
KNOWLEDGE_CRAWL_TIMEOUT_MS=45000
KNOWLEDGE_LOCAL_FETCH_TIMEOUT_MS=30000
KNOWLEDGE_CRAWL_DOMAIN_DELAY_MS=1000
KNOWLEDGE_CRAWL_MIN_TEXT_LENGTH=200
XCRAWL_BLOG_INDEX_URL=https://www.jotoai.com/sitemap.xml,https://sec.jotoai.com/sitemap.xml

# -----------------------------------------------------------------------------
# 7. File and log imports
# -----------------------------------------------------------------------------
IMPORT_ALLOWED_ROOT=D:/GTM/工作台-main-v5/imports
NGINX_ACCESS_LOG_PATH=
CDN_LOG_EXPORT_PATH=

# -----------------------------------------------------------------------------
# 8. Local draft/publish bridge
# -----------------------------------------------------------------------------
# Safe defaults: no real platform writes or public publishing.
WECHATSYNC_ENABLED=false
WECHATSYNC_MOCK=true
WECHATSYNC_BRIDGE_URL=http://127.0.0.1:9528
WECHATSYNC_BRIDGE_HOST=127.0.0.1
WECHATSYNC_BRIDGE_PORT=9528
WECHATSYNC_BRIDGE_TOKEN=
WECHATSYNC_PLATFORM_TIMEOUT_MS=30000
WECHATSYNC_USER_AGENT=Mozilla/5.0
JOTO_PUBLISH_BRIDGE_LEDGER_PATH=

# Content metrics runner. Keep the token local and use the same value in the
# workbench and runner process. Docker overrides the URL with its private
# service name; local development uses loopback.
CONTENT_METRICS_RUNNER_URL=http://127.0.0.1:9531
CONTENT_METRICS_RUNNER_HOST=127.0.0.1
CONTENT_METRICS_RUNNER_PORT=9531
CONTENT_METRICS_RUNNER_TOKEN=
CONTENT_METRICS_INTERVAL_SECONDS=21600
CONTENT_METRICS_PLATFORM_TIMEOUT_MS=20000

# Optional live authorization probes for cookie-based platforms. Without a
# probe URL the configuration center shows "configured but unverified".
CSDN_METRICS_AUTH_CHECK_URL=
JUEJIN_METRICS_AUTH_CHECK_URL=
ZHIHU_METRICS_AUTH_CHECK_URL=https://www.zhihu.com/api/v4/me

# Optional API overrides. Use these when a platform changes its response.
CSDN_METRICS_URL_TEMPLATE=
CSDN_METRICS_PATHS_JSON=
JUEJIN_METRICS_URL_TEMPLATE=
JUEJIN_METRICS_PATHS_JSON=
ZHIHU_METRICS_URL_TEMPLATE=
ZHIHU_METRICS_PATHS_JSON=

DIRECT_PUBLISH_ENABLED=false
DIRECT_PUBLISH_MOCK=true
DIRECT_PUBLISH_TIMEOUT_MS=120000
DIRECT_PUBLISH_STABLE_AFTER_HOURS=72
DIRECT_PUBLISH_VERIFICATION_TIMEOUT_HOURS=168

# -----------------------------------------------------------------------------
# 9. WeChat Official Account draft and publish
# -----------------------------------------------------------------------------
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_API_BASE_URL=https://api.weixin.qq.com

# Configure one cover source: permanent media_id or a local image path.
WECHAT_MP_THUMB_MEDIA_ID=
WECHAT_MP_THUMB_IMAGE_PATH=
WECHAT_MP_AUTHOR=
WECHAT_MP_DIGEST=
WECHAT_MP_CONTENT_SOURCE_URL=
WECHAT_MP_NEED_OPEN_COMMENT=0
WECHAT_MP_ONLY_FANS_CAN_COMMENT=0
WECHAT_PUBLISH_POLL_ATTEMPTS=10
WECHAT_PUBLISH_POLL_INTERVAL_MS=3000

# -----------------------------------------------------------------------------
# 10. CSDN draft adapter
# -----------------------------------------------------------------------------
CSDN_COOKIE=
CSDN_TAGS=AI,企业AI,Dify
CSDN_CATEGORIES=
CSDN_DRAFT_API_URL=https://bizapi.csdn.net/blog-console-api/v3/mdeditor/saveArticle
CSDN_API_GATEWAY_KEY=
CSDN_API_GATEWAY_SIGNING_KEY=
CSDN_DRAFT_PAYLOAD_JSON=
CSDN_HEADERS_JSON=
CSDN_AUTH_CHECK_URL=
CSDN_ORIGIN=https://editor.csdn.net
CSDN_REFERER=https://editor.csdn.net/

# -----------------------------------------------------------------------------
# 11. Juejin draft adapter
# -----------------------------------------------------------------------------
JUEJIN_COOKIE=
JUEJIN_TAG_IDS=
JUEJIN_TAG_LABELS=
JUEJIN_CATEGORY_ID=6809637771511070734
JUEJIN_CATEGORY_LABEL=
JUEJIN_CSRF_TOKEN=
JUEJIN_UUID=
JUEJIN_COVER_IMAGE=
JUEJIN_DRAFT_API_URL=
JUEJIN_DRAFT_API_QUERY=
JUEJIN_DRAFT_PAYLOAD_JSON=
JUEJIN_HEADERS_JSON=
JUEJIN_AUTH_CHECK_URL=
JUEJIN_ORIGIN=https://juejin.cn
JUEJIN_REFERER=https://juejin.cn/editor/drafts/new

# -----------------------------------------------------------------------------
# 12. Zhihu draft adapter
# -----------------------------------------------------------------------------
ZHIHU_COOKIE=
ZHIHU_XSRF_TOKEN=
ZHIHU_DRAFT_API_URL=https://zhuanlan.zhihu.com/api/articles/drafts
ZHIHU_DRAFT_PAYLOAD_JSON=
ZHIHU_DRAFT_UPDATE_URL_TEMPLATE=https://zhuanlan.zhihu.com/api/articles/{{draftId}}/draft
ZHIHU_DRAFT_UPDATE_PAYLOAD_JSON=
ZHIHU_DRAFT_UPDATE_METHOD=PATCH
ZHIHU_HEADERS_JSON=
ZHIHU_AUTH_CHECK_URL=
ZHIHU_ORIGIN=https://zhuanlan.zhihu.com
ZHIHU_REFERER=https://zhuanlan.zhihu.com/write
ZHIHU_MANUAL_TAKEOVER_REQUIRED=false

# -----------------------------------------------------------------------------
# 13. Arcs browser publish runner
# -----------------------------------------------------------------------------
# `npm.cmd run docker:3027` now starts this runner and Wechatsync Bridge in the
# background after the workbench is healthy. Prepare dependencies once with
# `uv sync --project arcs-runner`; keep both bearer tokens local and non-empty.
ARCS_RUNNER_URL=http://127.0.0.1:9530
ARCS_RUNNER_HOST=127.0.0.1
ARCS_RUNNER_PORT=9530
ARCS_RUNNER_TIMEOUT_MS=120000
WECHATSYNC_WORKBENCH_ASSET_BASE_URL=http://127.0.0.1:3027
WECHATSYNC_WORKBENCH_ASSET_TIMEOUT_MS=15000
ARCS_BROWSER_PATH=
JOTO_PUBLISH_RUNNER_TOKEN=
JOTO_PUBLISH_RUNNER_LEDGER_PATH=
JOTO_PUBLISH_PROFILE_ROOT=
CSDN_BROWSER_PROFILE_DIR=
JUEJIN_BROWSER_PROFILE_DIR=
ZHIHU_BROWSER_PROFILE_DIR=
ARCS_CSDN_SELECTORS_JSON=
ARCS_JUEJIN_SELECTORS_JSON=
ARCS_ZHIHU_SELECTORS_JSON=
ARCS_CSDN_BROWSER_PORT=9330
ARCS_JUEJIN_BROWSER_PORT=9431
ARCS_ZHIHU_BROWSER_PORT=9332

# Deterministic browser page-context executor. The runtime extension copy and
# token-bearing runtime-config.js are generated outside the repository.
PUBLISH_BROWSER_EXTENSION_ENABLED=false
PUBLISH_BROWSER_EXTENSION_PLATFORMS=juejin
JUEJIN_PAGE_CONTEXT_PUBLISH_ENABLED=true
JOTO_BROWSER_PUBLISH_JOB_STORE_PATH=
JOTO_BROWSER_PUBLISH_JOB_LEASE_MS=120000
JOTO_PUBLISH_EXTENSION_RUNTIME_DIR=
JOTO_PUBLISH_EXTENSION_ID=amejiagagacknhmkjgnefkhpbikkbedo
PUBLISH_REWRITE_AI_PROVIDER=qwen

# -----------------------------------------------------------------------------
# 14. AI front-test capture runner
# -----------------------------------------------------------------------------
V5_CAPTURE_RUNNER_URL=http://127.0.0.1:17321
V5_CAPTURE_RUNNER_PORT=17321
V5_CAPTURE_EXTENSION_ID=
V5_CAPTURE_CHROME_PROFILE_DIRECTORY=Default
V5_CAPTURE_AUTO_LAUNCH_CHROME=true
NEXT_PUBLIC_V5_CAPTURE_EXTENSION_ID=

# Optional browser renderer for client-rendered brand websites. Leave blank to
# fail closed with a "rendering unverified" finding instead of guessing.
SITE_AUDIT_MAX_PAGES=25
SITE_AUDIT_WORKER_INTERVAL_SECONDS=30
SITE_AUDIT_RENDERER_URL=
SITE_AUDIT_RENDERER_TOKEN=
GEO_MONITORING_SCHEDULER_INTERVAL_SECONDS=3600

# -----------------------------------------------------------------------------
# 15. Workers and protected write APIs
# -----------------------------------------------------------------------------

# Hosted identity and governed channel-account connections. The public URL must
# be reachable from user emails. Keep all secret values in the ignored .env.
HOSTED_PUBLIC_BASE_URL=http://127.0.0.1:3027
HOSTED_REVIEW_LINK_SECRET=
HOSTED_EMAIL_DELIVERY_URL=
HOSTED_EMAIL_DELIVERY_TOKEN=
HOSTED_EMAIL_SETUP_TOKEN=
HOSTED_EMAIL_CREDENTIAL_ENCRYPTION_KEY=
HOSTED_EMAIL_OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:3027
HOSTED_EMAIL_GOOGLE_CLIENT_ID=
HOSTED_EMAIL_GOOGLE_CLIENT_SECRET=
HOSTED_EMAIL_MICROSOFT_CLIENT_ID=
HOSTED_EMAIL_MICROSOFT_CLIENT_SECRET=
HOSTED_DAILY_DIGEST_CUTOFF_HOUR=20
PUBLISH_DEFAULT_EXECUTOR_TYPE=cloud_browser
PUBLISH_EXECUTOR_REGISTRATION_SECRET=
PUBLISH_EXECUTOR_API_BASE_URL=http://workbench-web:3027
PUBLISH_EXECUTOR_TYPE=cloud_browser
PUBLISH_EXECUTOR_CAPACITY=1
PUBLISH_EXECUTOR_POLL_INTERVAL_MS=2000
PUBLISH_EXECUTOR_STATE_PATH=/app/runtime/browser-executor-node.json
JOTO_PUBLISH_RUNNER_URL=http://host.docker.internal:9530
JOTO_PUBLISH_RUNNER_TOKEN=

V5_CONTENT_WORKER_BATCH_SIZE=20
V5_SAMPLE_WORKER_BATCH_SIZE=3
# Keep production concurrency at 1 until a complete batch passes runtime SLO checks.
V5_SAMPLE_WORKER_CONCURRENCY=2
V5_CONTENT_WORKER_CONCURRENCY=2
V5_SAMPLE_OPERATION_STALE_MINUTES=20
V5_SAMPLE_OPERATION_MAX_ATTEMPTS=3
V5_SINGLE_ARTICLE_WRITES_ENABLED=false
V5_SINGLE_ARTICLE_ACTOR_ID=
V5_SINGLE_ARTICLE_ACTOR_ROLE=developer_admin

# Optional bootstrap/acceptance helpers
V5_SINGLE_ARTICLE_BOOTSTRAP_ACTOR_ID=single-article-bootstrap
V5_SINGLE_ARTICLE_BOOTSTRAP_ACTOR_ROLE=developer_admin
V5_SINGLE_ARTICLE_MONTH=
V5_SINGLE_ARTICLE_BASE_URL=http://127.0.0.1:3050
V5_SINGLE_ARTICLE_ACCEPTANCE_KEY=

# -----------------------------------------------------------------------------
# 16. GEO research (three-provider factual search + Zhipu semantic synthesis)
# -----------------------------------------------------------------------------
GEO_RESEARCH_ZHIPU_API_KEY=
GEO_RESEARCH_ZHIPU_MODEL=glm-4-air
GEO_RESEARCH_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GEO_RESEARCH_ZHIPU_SEARCH_ENGINE=search_pro
GEO_RESEARCH_ZHIPU_SEARCH_COUNT=10
GEO_RESEARCH_ZHIPU_SEARCH_RECENCY=noLimit
GEO_RESEARCH_ZHIPU_CONTENT_SIZE=high
GEO_RESEARCH_ZHIPU_MAX_QUERIES=3
GEO_RESEARCH_DOUBAO_API_KEY=
GEO_RESEARCH_DOUBAO_MODEL=
GEO_RESEARCH_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GEO_RESEARCH_QWEN_API_KEY=
GEO_RESEARCH_QWEN_MODEL=
GEO_RESEARCH_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Non-secret, versioned channel policy. GEO_CHANNEL_RULE_PACK_JSON can override it temporarily.
GEO_CHANNEL_RULE_PACK_PATH=config/geo-channel-rule-pack.json

# -----------------------------------------------------------------------------
# 17. Dynamic knowledge collection
# -----------------------------------------------------------------------------
KNOWLEDGE_COLLECTION_AI_PROVIDER=qwen
KNOWLEDGE_COLLECTION_FETCH_TIMEOUT_MS=20000
KNOWLEDGE_COLLECTION_ACTOR_ID=v5-knowledge-collection-worker
KNOWLEDGE_COLLECTION_ACTOR_ROLE=knowledge_collection_scheduler
WECHAT_COLLECTION_BASE_URL=
WECHAT_COLLECTION_API_KEY=
